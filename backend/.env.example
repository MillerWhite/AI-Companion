# Copy to .env. Never commit real credentials.
AI_API_KEY=
# OpenAI-compatible API base URL (without /chat/completions)
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-6-luna
AI_TIMEOUT_SECONDS=20
# Comma-separated browser origins allowed to call this backend.
AI_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
