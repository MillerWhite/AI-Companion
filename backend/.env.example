# Default: free local inference through Ollama. No API key or billing.
AI_PROVIDER=ollama
AI_API_KEY=
AI_API_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3.5:4b
AI_TIMEOUT_SECONDS=90
# Comma-separated browser origins allowed to call this backend.
AI_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional remote OpenAI-compatible provider (may be paid):
# AI_PROVIDER=openai_compatible
# AI_API_KEY=put_your_provider_key_here
# AI_API_BASE_URL=https://provider.example/v1
# AI_MODEL=provider-model-name
