# Primary provider: Yandex AI Studio (API accessible from Russia).
AI_PROVIDER=yandex
AI_API_KEY=PASTE_YANDEX_AI_STUDIO_API_KEY_HERE
AI_FOLDER_ID=PASTE_YANDEX_CATALOG_ID_HERE
AI_API_BASE_URL=https://ai.api.cloud.yandex.net/v1
AI_MODEL=aliceai-llm-flash
AI_TIMEOUT_SECONDS=30
# Set this to the exact origin of your hosted website.
AI_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
