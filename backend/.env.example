APP_ENV=development
DEVICE_ENROLLMENT_SECRET=GENERATE_A_LONG_RANDOM_SERVER_ONLY_SECRET
STORE_WEBHOOK_SECRET=GENERATE_A_DIFFERENT_RANDOM_WEBHOOK_SECRET
DEVICE_DB_PATH=backend/devices.sqlite3
DATABASE_URL=
REDIS_URL=
DEVICE_REQUESTS_PER_MINUTE=20
AI_DAILY_REQUEST_LIMIT=250
MEMORY_RETENTION_DAYS=90
SPEECHKIT_DAILY_SECONDS_LIMIT=120
SPEECHKIT_DAILY_TOTAL_SECONDS_LIMIT=3600
# Yandex AI Studio / SpeechKit. Keep every API key in backend secret storage only.
AI_PROVIDER=yandex
AI_API_KEY=PASTE_YANDEX_AI_STUDIO_API_KEY_HERE
AI_FOLDER_ID=b1gikqq12lquq0ak69sh
AI_API_BASE_URL=https://ai.api.cloud.yandex.net/v1
AI_MODEL=aliceai-llm-flash
AI_TIMEOUT_SECONDS=30
SPEECHKIT_API_KEY=PASTE_YANDEX_SPEECHKIT_API_KEY_HERE
# Leave blank for a service-account API key; set only for user-account auth.
SPEECHKIT_FOLDER_ID=
SPEECHKIT_SAMPLE_RATE=16000
# Set exact hosted website origin(s), comma separated.
AI_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8787,http://127.0.0.1:8787
ALLOWED_HOSTS=localhost,127.0.0.1
