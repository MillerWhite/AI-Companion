# Copy into the host's secret store or protected backend/.env. Never commit actual values.
APP_ENV=production
API_DOMAIN=api.your-site.example
DEVICE_ENROLLMENT_SECRET=GENERATE_32_BYTES_OR_MORE
STORE_WEBHOOK_SECRET=GENERATE_A_DIFFERENT_32_BYTES_OR_MORE
AI_PROVIDER=yandex
AI_API_KEY=SERVER_SIDE_YANDEX_AI_STUDIO_KEY
AI_FOLDER_ID=YOUR_YANDEX_FOLDER_ID
AI_API_BASE_URL=https://ai.api.cloud.yandex.net/v1
AI_MODEL=YOUR_CONFIRMED_MODEL_ALIAS
AI_TIMEOUT_SECONDS=20
SPEECHKIT_API_KEY=SERVER_SIDE_SPEECHKIT_KEY
SPEECHKIT_FOLDER_ID=YOUR_SPEECHKIT_FOLDER_ID
SPEECHKIT_SAMPLE_RATE=16000
DEVICE_REQUESTS_PER_MINUTE=20
AI_DAILY_REQUEST_LIMIT=250
SPEECHKIT_DAILY_SECONDS_LIMIT=120
MEMORY_RETENTION_DAYS=90
AI_ALLOWED_ORIGINS=https://your-site.example
ALLOWED_HOSTS=api.your-site.example
POSTGRES_DB=ai_companion
POSTGRES_USER=ai_companion
POSTGRES_PASSWORD=GENERATE_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD
